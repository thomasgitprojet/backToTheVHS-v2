{# templates/account/account.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon compte | Back to the VHS{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round md:flex flex-col items-center md:pt-12 md:gap-6"
    style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">
    <div class="text-center">
        <h2 class="text-4xl font-bold mb-4">Mon compte</h2>
    </div>
    <div class="max-w-5xl mx-auto bg-gray-800/50 rounded-lg shadow-lg p-8 text-white mt-8 space-y-12">

        <!-- Section Infos Utilisateur -->
        <section>
            <h2 class="text-2xl font-bold mb-6 border-b border-gray-600 pb-2">Mes informations</h2>
            <ul class="space-y-4">
                {% set infos = {
                'Nom': 'Dupont',
                'Prénom': 'Jean',
                'Pseudo': 'jeanvhs',
                'Âge': '32',
                'Email': 'jean.dupont@email.com'
                } %}
                {% for label, value in infos %}
                <li class="flex justify-between items-center bg-gray-700 rounded-md px-4 py-2">
                    <span><strong>{{ label }} :</strong> {{ value }}</span>
                    <button class="text-yellow-400 hover:underline text-sm">✎ Éditer</button>
                </li>
                {% endfor %}
            </ul>
        </section>

        <!-- Section Produits en vente -->
        <section>
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold border-b border-gray-600 pb-2">Mes produits en vente</h2>
                <a href="{{ path('app_new_product') }}"
                    class="bg-green-500 hover:bg-green-600 text-white font-semibold px-4 py-2 rounded-md text-sm inline-block">
                    ➕ Créer une annonce
                </a>
            </div>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for i in 1..3 %}
                <div class="border-2 border-white rounded-md p-4 bg-gray-700 space-y-3">
                    <img src="{{ asset('build/images/bToVHS.png') }}" alt="image produit"
                        class="w-full h-48 object-contain rounded-md bg-black">
                    <h4 class="text-lg font-bold">Nom du produit {{ i }}</h4>
                    <p class="text-sm">Description du produit {{ i }}. Lorem ipsum dolor sit amet.</p>
                    <p class="text-lg font-bold">Prix : 9,99€</p>
                    <div class="flex justify-between pt-2">
                        <button
                            class="bg-yellow-400 hover:bg-yellow-500 text-black px-3 py-1 rounded text-sm font-semibold">Modifier</button>
                        <button
                            class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm font-semibold">Supprimer</button>
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>

        <!-- Bouton Supprimer le compte -->
        <div class="text-center pt-6 border-t border-gray-700">
            <button class="bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-2 rounded-md mt-4 text-sm">
                🗑️ Supprimer mon compte
            </button>
        </div>
    </div>
    {% endblock %}