<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Back To The VHS{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body class="bg-gray-900 text-white font-sans min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-black text-yellow-400 py-6 px-4 text-center shadow-lg">
        <!-- <h1 class="text-4xl font-extrabold tracking-wider uppercase">
            Back To The VHS11
        </h1> -->
        <img src="{{ encore_entry_asset('app', 'images/bToVHS.png') }}" alt="Back To The VHS" class="w-64 mx-auto">
        <p class="text-sm text-gray-400 mt-2">La vintage n’a jamais été aussi stylé</p>
    </header>

    <!-- Navigation -->
    <nav class="bg-gray-800 text-white py-3 px-6 shadow-md">
        <ul class="flex justify-center gap-6 text-lg font-medium">
            <li><a href="{{ path('home') }}" class="hover:text-yellow-400 transition">Accueil</a></li>
            <li><a href="#" class="hover:text-yellow-400 transition">Catalogue</a></li>
            <li><a href="#" class="hover:text-yellow-400 transition">Contact</a></li>
        </ul>
    </nav>

    <!-- Contenu principal -->
    <main class="flex-1 px-6 py-10">
        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-black text-center text-sm text-gray-500 py-4">
        &copy; {{ "now"|date("Y") }} Back To The VHS - Tous droits réservés
    </footer>
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</body>
</html>
