{# templates/register/register.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Hello RegisterController!{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round md:flex flex-col items-center md:py-12 md:gap-6"
     style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">

    <div class="w-full max-w-xl bg-gray-800/50 rounded-lg shadow-lg p-8 mx-auto">
        <h2 class="text-2xl font-bold mb-6 text-center text-yellow-400">Créer un compte</h2>

        {{ form_start(registerForm) }}
        <div class="flex flex-col gap-4">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {{ form_row(registerForm.name, {'row_attr': {'class': 'mb-0'}, 'attr': {'class': 'w-full px-4 py-2 rounded-md bg-gray-700 text-white border border-gray-600 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-400'}}) }}
                {{ form_row(registerForm.firstName, {'row_attr': {'class': 'mb-0'}, 'attr': {'class': 'w-full px-4 py-2 rounded-md bg-gray-700 text-white border border-gray-600 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-400'}}) }}
            </div>

            {{ form_row(registerForm.pseudo, {'attr': {'class': 'w-full px-4 py-2 rounded-md bg-gray-700 text-white border border-gray-600 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-400'}}) }}

            {{ form_row(registerForm.dateBirth, {'attr': {'class': 'w-full px-4 py-2 rounded-md bg-gray-700 text-white border border-gray-600 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-400'}}) }}

            {{ form_row(registerForm.email, {'attr': {'class': 'w-full px-4 py-2 rounded-md bg-gray-700 text-white border border-gray-600 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-400'}}) }}

            {{ form_row(registerForm.plainPassword.first, {'attr': {'class': 'w-full px-4 py-2 rounded-md bg-gray-700 text-white border border-gray-600 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-400'}}) }}

            {{ form_row(registerForm.plainPassword.second, {'attr': {'class': 'w-full px-4 py-2 rounded-md bg-gray-700 text-white border border-gray-600 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-400'}}) }}
        </div>

        {# reCAPTCHA v2 #}
        <div class="g-recaptcha mt-4" data-sitekey="{{ recaptcha_site_key }}">
        </div>

        <button type="submit"
                class="w-full mt-6 bg-yellow-400 hover:bg-yellow-500 text-black font-semibold py-2 px-4 rounded-md transition duration-200">
            Créer mon compte
        </button>

        {{ form_end(registerForm) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endblock %}