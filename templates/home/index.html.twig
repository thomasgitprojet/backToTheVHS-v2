{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accueil | Back to the VHS{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round md:flex flex-col items-center md:py-12 md:gap-6"
    style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">
    <div class="text-center">
        <h2 class="text-4xl font-bold pt-4 mb-4">Bienvenue sur Back to the VHS</h2>
        <p class="text-lg">Un site de vente fictif de cassettes VHS vintage pour les vrais amateurs !</p>
    </div>
    <div class="max-w-7xl mx-auto p-6">
        <h2 class="text-3xl font-bold text-yellow-400 text-center mb-10">Nos derniers produits ajoutés</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
            {% for publication in publications %}
        <div class="bg-gray-800/50 p-4 rounded-lg shadow-lg flex flex-col">
            <img src="{{ asset('uploads/images/' ~ publication.product.image) }}" alt="{{ publication.product.movie.title ?? 'Produit' }}"
                 class="rounded-md mb-4 h-48 object-contain">
            <h3 class="text-xl font-semibold text-white mb-2">{{ publication.product.movie.title }}</h3>
            <p class="text-sm text-gray-300 mb-4">{{ publication.product.descriptionProduct }}</p>
            <p class="text-yellow-400 font-bold text-lg mb-4">{{ publication.product.priceProduct|number_format(2, ',', ' ') }} €</p>
            <a href="{{ path('app_product', {'id': publication.id}) }}"
               class="mt-auto bg-yellow-400 text-black text-center py-2 px-4 rounded-md hover:bg-yellow-500 transition">
                Voir le produit
            </a>
        </div>
    {% else %}
        <p>Aucun produit disponible pour le moment.</p>
    {% endfor %}
        </div>
    </div>
</div>
{% endblock %}