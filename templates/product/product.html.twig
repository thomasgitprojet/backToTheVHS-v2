{# templates/product/product.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Fiche produit | Back to the VHS{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round md:flex flex-col items-center md:pt-12 md:gap-6 min-h-screen"
     style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">

    <div class="max-w-7xl mx-auto p-6 bg-gray-800/50 rounded-lg shadow-lg">
        <h2 class="text-3xl font-bold text-yellow-400 text-center mb-10">
            {{ publication.product.movie.title }}
        </h2>

        <div class="flex flex-col md:flex-row gap-8">
            
            <!-- Image -->
            <div class="md:w-1/2 flex justify-center">
                <img src="{{ asset('uploads/images/' ~ publication.product.image) }}" 
                     alt="{{ publication.product.movie.title }}" 
                     class="rounded-md max-h-96 object-contain" />
            </div>

            <!-- Détails produit -->
            <div class="md:w-1/2 flex flex-col text-white">
                <h3 class="text-2xl font-bold mb-4">{{ publication.product.movie.title }}</h3>
                
                <p class="text-gray-300 mb-6">
                    {{ publication.product.descriptionProduct }}
                </p>

                <p class="mb-4">
                    <span class="font-semibold">Film :</span> {{ publication.product.movie.title }}
                </p>

                <p class="text-yellow-400 font-bold text-2xl mb-8">
                    {{ publication.product.priceProduct }} €
                </p>

                <button type="button"
                    onclick="addToCart('{{ publication.id }}')"
                    class="self-start bg-yellow-400 text-black font-bold py-3 px-8 rounded-md hover:bg-yellow-500 transition">
                    Ajouter au panier
                </button>

                <a href="{{ path('app_products') }}" 
                   class="mt-6 inline-block text-yellow-400 hover:underline">
                   ← Retour au catalogue
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}