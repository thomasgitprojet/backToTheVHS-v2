<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>{% block title %}Back To The VHS{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>

<body data-flashes='{{ app.flashes|json_encode|e('html_attr') }}' class="bg-gray-900 text-white font-sans min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-black text-yellow-400 py-6 px-4 text-center shadow-lg">
        <div class="flex flex-col items-center text-center md:flex-row md:items-center md:justify-start md:pt-12 md:pl-12">
            <!-- Logo + tagline -->
            <div class="flex flex-col items-center md:items-start">
                <a href="{{ path('home') }}" 
                class="inline-block transform transition-all duration-300 hover:scale-105 hover:rotate-1 hover:shadow-lg hover:animate-bounce-vhs">
                    <img src="{{ asset('build/images/bToVHS.png') }}" alt="Back To The VHS"
                        class="w-64 mx-auto md:w-96 md:mx-0 filter hover:contrast-125 hover:brightness-110 hover:saturate-150">
                </a>
                <p class="flex justify-center text-yellow-400 mt-2 mb-4 md:pl-20">
                    La vintage n’a jamais été aussi stylé
                </p>
            </div>

            <!-- Animation Popcorn -->
            <div id="popcorn-animation" class="w-28 h-28 md:w-40 md:h-40 md:ml-4"></div>
        </div>

        <!-- Navigation -->
        <div>
            <ul class="flex justify-center gap-4 md:justify-end items-center">
                {% if is_granted('ROLE_ADMIN') %}
                    <li>
                        <a href="{{ path('app_admin_dashboard') }}" 
                        class="flex items-center gap-2 relative group text-yellow-400 font-semibold">
                            <img src="{{ asset('build/images/icons8-paramètres-32.png') }}" alt="icon compte"> Admin
                            <span class="absolute left-0 bottom-0 w-0 h-0.5 bg-yellow-400 transition-all duration-300 group-hover:w-full"></span>
                        </a>
                    </li>
                {% endif %}

                <li>
                    {% if app.user %}
                    <form action="{{ path('app_logout') }}" method="POST">
                        <button type="submit" 
                                class="flex items-center gap-2 relative group hover:text-yellow-400 transition">
                            Déconnexion
                            <span class="absolute left-0 bottom-0 w-0 h-0.5 bg-yellow-400 transition-all duration-300 group-hover:w-full"></span>
                        </button>
                    </form>
                    {% else %}
                    <a href="{{ path('app_connection') }}" 
                    class="flex items-center gap-2 relative group">
                        Connexion
                        <span class="absolute left-0 bottom-0 w-0 h-0.5 bg-yellow-400 transition-all duration-300 group-hover:w-full"></span>
                    </a>
                    {% endif %}
                </li>

                <li>
                    <a class="flex items-center gap-2 relative group" href="{{ path('app_account') }}">
                        <img src="{{ asset('build/images/icons8-account-30.png') }}" alt="icon compte">
                        Mon compte
                        <span class="absolute left-0 bottom-0 w-0 h-0.5 bg-yellow-400 transition-all duration-300 group-hover:w-full"></span>
                    </a>
                </li>

                <li class="relative">
                    <a class="flex items-center gap-2 relative group" href="{{ path('app_my_cart') }}">
                        <img src="{{ asset('build/images/icons8-basket-30.png') }}" alt="">
                        Mon panier
                        {% set cartCount = app.session.get('cart') ? app.session.get('cart')|length : 0 %}
                        {% if cartCount > 0 %}
                            <span id="cart-count"
                                class="absolute -top-2 -right-3 bg-yellow-400 text-black rounded-full w-5 h-5 text-xs flex items-center justify-center">
                                {{ cartCount }}
                            </span>
                        {% endif %}
                        <span class="absolute left-0 bottom-0 w-0 h-0.5 bg-yellow-400 transition-all duration-300 group-hover:w-full"></span>
                    </a>
                </li>
            </ul>
        </div>
    </header>

    <!-- Navigation mobile -->
    <nav class="bg-gray-800 text-white py-3 shadow-md md:hidden">
        <button id="burger-btn" class="flex justify-center ml-6 md:hidden text-white text-3xl"
            aria-label="Ouvrir le menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
        <button id="close-btn" class="flex justify-center ml-6 hidden md:hidden text-white text-3xl"
            aria-label="Fermer le menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24"
                stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
        </button>
        <ul id="mobile-menu" class="hidden bg-gray-800 w-full text-lg font-medium flex flex-col gap-6 pl-12 absolute">
            <li><a href="{{ path('home') }}" class="hover:text-yellow-400 transition">Accueil</a></li>
            <li><a href="{{ path('app_products') }}" class="hover:text-yellow-400 transition">Catalogue</a></li>
            <li><a href="{{ path('app_contact') }}" class="hover:text-yellow-400 transition">Contact</a></li>
        </ul>
    </nav>

    <!-- Navigation desktop -->
   <nav class="bg-gray-800/80 backdrop-blur-md text-white py-3 px-6 shadow-md hidden md:block">
        <ul class="flex justify-center gap-6 text-lg font-medium md:text-2xl text-white drop-shadow-md">
            <!-- Accueil -->
            <li>
                <a href="{{ path('home') }}" 
                class="relative group transition duration-300 ease-in-out
                        {% if app.request.get('_route') == 'home' %}text-yellow-400 font-bold{% endif %}">
                    Accueil
                    <span class="absolute left-0 -bottom-1 w-0 h-1 bg-yellow-400 transition-all group-hover:w-full"></span>
                </a>
            </li>

            <!-- Catalogue -->
            <li>
                <a href="{{ path('app_products') }}" 
                class="relative group transition duration-300 ease-in-out
                        {% if app.request.get('_route') == 'app_products' %}text-yellow-400 font-bold{% endif %}">
                    Catalogue
                    <span class="absolute left-0 -bottom-1 w-0 h-1 bg-yellow-400 transition-all group-hover:w-full"></span>
                </a>
            </li>

            <!-- Contact -->
            <li>
                <a href="{{ path('app_contact') }}" 
                class="relative group transition duration-300 ease-in-out
                        {% if app.request.get('_route') == 'app_contact' %}text-yellow-400 font-bold{% endif %}">
                    Contact
                    <span class="absolute left-0 -bottom-1 w-0 h-1 bg-yellow-400 transition-all group-hover:w-full"></span>
                </a>
            </li>
        </ul>
    </nav> 

    <!-- Contenu principal -->
    <main>
        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <!-- <footer class="bg-black text-center text-sm text-gray-500 py-4">
        &copy; {{ "now"|date("Y") }} Back To The VHS - Tous droits réservés
    </footer> -->

    <footer class="bg-gray-900 text-gray-400 py-10">
        <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8">

            <!-- Infos & contact -->
            <div class="space-y-2">
                <h3 class="text-white font-bold text-lg">Back To The VHS</h3>
                <p>thomasdesse.pro@gmail.com</p>
                <p>06 89 54 71 10</p>
                <p><a href="" class="hover:text-yellow-400 transition">Mentions légales</a></p>
                <p><a href="" class="hover:text-yellow-400 transition">Politique de confidentialité</a></p>
            </div>

            <!-- Navigation rapide -->
            <div class="space-y-2">
                <h3 class="text-white font-bold text-lg">Navigation</h3>
                <ul class="space-y-1">
                    <li><a href="{{ path('home') }}" class="hover:text-yellow-400 transition">Accueil</a></li>
                    <li><a href="{{ path('app_products') }}" class="hover:text-yellow-400 transition">Catalogue</a></li>
                    <li><a href="{{ path('app_contact') }}" class="hover:text-yellow-400 transition">Contact</a></li>
                </ul>
            </div>

            <!-- Réseaux sociaux / slogan -->
            <div class="space-y-4">
                <h3 class="text-white font-bold text-lg">Suivez-nous</h3>
                <div class="flex gap-4">
                    <a href="https://facebook.com" class="hover:text-yellow-400 transition"><i class="fab fa-facebook-f"></i><img src="{{ asset('build/images/icons8-facebook-nouveau-32.png') }}" alt="icon facebook"></a>
                    <a href="https://twitter.com" class="hover:text-yellow-400 transition"><i class="fab fa-twitter"></i><img src="{{ asset('build/images/icons8-twitter-32.png') }}" alt="icon twitter"></a>
                    <a href="https://instagram.com" class="hover:text-yellow-400 transition"><i class="fab fa-instagram"></i><img src="{{ asset('build/images/icons8-instagram-32.png') }}" alt="icon instagram"></a>
                    <a href="https://youtube.com" class="hover:text-yellow-400 transition"><i class="fab fa-youtube"></i><img src="{{ asset('build/images/icons8-youtube-32.png') }}" alt="icon youtube"></a>
                </div>
                <p class="text-sm">Revivez l’âge d’or du cinéma en vhs 🎬</p>
            </div>

        </div>

        <!-- Copyright -->
        <div class="mt-8 border-t border-gray-700 pt-4 text-center text-sm text-gray-500">
            &copy; {{ "now"|date("Y") }} Back To The VHS - Tous droits réservés
        </div>
    </footer>

    {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% endblock %}


    {# Script ajout au panier et compteur dynamique #}
    <script>
        function addToCart(productId) {
            fetch(`/cart/add/${productId}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                // Met à jour le compteur du panier
                let counter = document.getElementById('cart-count');
                if (!counter) {
                    counter = document.createElement('span');
                    counter.id = 'cart-count';
                    counter.className = 'absolute -top-2 -right-3 bg-yellow-400 text-black rounded-full w-5 h-5 text-xs flex items-center justify-center';
                    document.querySelector('a[href$="/my/cart"]').appendChild(counter);
                }
                counter.textContent = data.count;

                // Affiche le flash
                if (data.type === 'success') {
                    showFlash(data.message, 'success', {
                        persistent: true,
                        actions: [
                            {
                                label: "Continuer mes achats",
                                onClick: "this.closest('.flash-message').remove()",
                                class: "bg-gray-800 hover:bg-gray-700 text-white px-4 py-2 rounded-md"
                            },
                            {
                                label: "Voir mon panier",
                                onClick: "window.location.href='/my/cart'",
                                class: "bg-yellow-400 hover:bg-yellow-500 text-black px-4 py-2 rounded-md"
                            }
                        ]
                    });
                } else if (data.type === 'warning') {
                    // Produit déjà présent
                    showFlash(data.message, 'warning'); // disparaît automatiquement
                } else {
                    // Cas danger ou autre
                    showFlash(data.message, data.type);
                }
            })
            .catch(() => {
                showFlash("Impossible d'ajouter le produit pour le moment.", 'danger');
            });
        }
    </script>

    <script>
        function showFlash(message, type = 'success', options = {}) {
            const typeClasses = {
                success: 'bg-green-600 text-white',
                warning: 'bg-yellow-400 text-black',
                danger: 'bg-red-600 text-white',
                info: 'bg-blue-600 text-white'
            };

            const flash = document.createElement('div');
            flash.className = `flash-message fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 
                            px-6 py-4 rounded-2xl shadow-2xl z-50 text-center text-lg transition-opacity 
                            duration-1000 ease-in-out ${typeClasses[type] || typeClasses.success}`;

            if (options.actions) {
                flash.innerHTML = `
                    <p class="mb-4">${message}</p>
                    <div class="flex gap-3 justify-center">
                        ${options.actions.map(action =>
                            `<button onclick="${action.onClick}" 
                                    class="px-4 py-2 rounded-xl shadow-md transition
                                            ${action.class}">
                                ${action.label}
                            </button>`
                        ).join('')}
                    </div>
                `;
            } else {
                flash.textContent = message;

                if (!options.persistent) {
                    setTimeout(() => {
                        flash.classList.add('opacity-0');
                        setTimeout(() => flash.remove(), 1000);
                    }, options.timeout || 3000);
                }
            }

            document.body.appendChild(flash);
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Mapping labels Symfony vers types utilisés par showFlash
            const labelMapping = {
                success: 'success',
                danger: 'danger',
                warning: 'warning',
                info: 'info' // tu peux ajouter d'autres labels si besoin
            };

            // Récupère les flashes depuis le data-attribute
            const flashes = JSON.parse(document.body.dataset.flashes || '{}');
        
            for (const label in flashes) {
                const type = labelMapping[label] || 'success'; // fallback
                flashes[label].forEach(message => {
                    showFlash(message, type);
                });
            }
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.10.2/lottie.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const container = document.getElementById('popcorn-animation');

        if (container) {
            lottie.loadAnimation({
                container: container,
                renderer: 'svg',
                loop: true,          // ✅ Boucle infinie
                autoplay: true,      // ✅ Démarre automatiquement
                path: '{{ asset("animations/Popcorn.json") }}'
            });
        }
    });
</script>

</body>
