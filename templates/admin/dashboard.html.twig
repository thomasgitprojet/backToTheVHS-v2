{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | Back to the VHS{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round min-h-screen pt-20 md:pt-32 px-6"
    style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">

    <div class="max-w-6xl mx-auto bg-gray-800/70 rounded-lg shadow-lg p-8">
        <h1 class="text-3xl font-bold text-yellow-400 mb-6">Tableau de bord Admin</h1>
        <p class="text-white mb-10">Bienvenue {{ app.user.pseudo }} 👋</p>

        <h2 class="text-2xl font-semibold text-yellow-300 mb-4">Utilisateurs inscrits</h2>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse border border-gray-700">
                <thead class="bg-gray-700 text-yellow-400">
                    <tr>
                        <th class="border border-gray-600 px-4 py-2">ID</th>
                        <th class="border border-gray-600 px-4 py-2">Pseudo</th>
                        <th class="border border-gray-600 px-4 py-2">Email</th>
                        <th class="border border-gray-600 px-4 py-2">Rôles</th>
                        <th class="border border-gray-600 px-4 py-2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="hover:bg-gray-800">
                            <td class="border border-gray-600 px-4 py-2">{{ user.id }}</td>
                            <td class="border border-gray-600 px-4 py-2">{{ user.pseudo }}</td>
                            <td class="border border-gray-600 px-4 py-2">{{ user.email }}</td>
                            <td class="border border-gray-600 px-4 py-2">{{ user.roles|join(', ') }}</td>
                            <td class="border border-gray-600 px-4 py-2 space-x-2">
                                <a href="{{ path('app_admin_user_show', {id: user.id}) }}" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm">Voir</a>
                                <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="bg-yellow-400 hover:bg-yellow-500 text-black px-3 py-1 rounded text-sm">Éditer</a>
                                <form method="POST" action="{{ path('app_admin_user_delete', { id: user.id }) }}" 
                                    style="display:inline;" 
                                    onsubmit="return confirm('⚠️ Es-tu sûr de vouloir supprimer cet utilisateur ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                    <button type="submit" 
                                            class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm">
                                        Supprimer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-gray-400 py-6">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}