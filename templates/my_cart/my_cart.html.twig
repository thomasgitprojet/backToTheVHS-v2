{# templates/my_cart/my_cart.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round flex flex-col items-center min-h-screen pt-20 md:pt-32 md:gap-6"
     style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">

    <div class="w-full max-w-4xl bg-gray-800/50 rounded-lg shadow-lg p-8 mx-auto">
        <h2 class="text-2xl font-bold mb-6 text-center text-yellow-400">Mon Panier</h2>

        {% if cartItems is not empty %}
            <div class="space-y-6">
                {% for publication in cartItems %}
                    <div id="cart-item-{{ publication.id }}" 
                        class="flex flex-col md:flex-row items-center bg-gray-700 p-4 rounded-lg shadow-sm">
                        <img src="{{ asset('uploads/images/' ~ publication.product.image) }}" 
                            alt="{{ publication.product.movie.title }}"
                            class="w-24 h-24 object-contain rounded-md mb-4 md:mb-0 md:mr-6">
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-white">{{ publication.product.movie.title }}</h3>
                            <p class="text-sm text-gray-300" data-price="{{ publication.product.priceProduct }}">Prix unitaire : {{ publication.product.priceProduct }} €</p>
                        </div>
                        <button onclick="removeFromCart('{{ publication.id }}')"
                                class="mt-4 md:mt-0 bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm">
                            Retirer
                        </button>
                    </div>
                {% endfor %}
            </div>

            <!-- Total -->
            <div class="mt-8 border-t border-gray-600 pt-6 text-right">
                <p class="text-lg font-semibold text-white mb-4">
                    Total du panier : 
                    <span id="cart-total" class="text-yellow-400">
                        {{ cartItems|reduce((carry, item) => carry + item.product.priceProduct, 0)|number_format(2, ',', ' ') }} €
                    </span>
                </p>
                <button
                    class="bg-yellow-400 hover:bg-yellow-500 text-black font-semibold py-2 px-6 rounded-md transition duration-200">
                    <a href="{{ path('app_cart_checkout') }}"
                    class="bg-yellow-400 hover:bg-yellow-500 text-black font-semibold py-2 px-6 rounded-md transition duration-200 inline-block">
                    Valider la commande
                    </a>
                </button>
            </div>
        {% else %}
            <p class="text-center text-gray-300">Votre panier est vide.</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function removeFromCart(publicationId) {
            fetch(`/cart/remove/${publicationId}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.type === 'success') {
                    // Supprime le bloc produit du DOM
                    const item = document.getElementById(`cart-item-${publicationId}`);
                    if (item) item.remove();
                }

                // Met à jour le compteur du panier
                const cartCount = document.getElementById('cart-count');
                if (cartCount) {
                    cartCount.textContent = data.count;

                    if (data.count === 0) {
                        cartCount.remove();
                    }
                }

                // Recalcule le total du panier
                const prices = document.querySelectorAll('[data-price]');
                let total = 0;
                prices.forEach(el => {
                    total += parseFloat(el.dataset.price);
                });

                const totalEl = document.getElementById('cart-total');
                if (totalEl) {
                    if (total > 0) {
                        totalEl.textContent = total.toFixed(2).replace('.', ',') + ' €';
                    } else {
                        // Si le panier est vide → recharger la page
                        window.location.reload();
                    }
                }

                // Vérifie si le panier est vide → recharger la page pour afficher "Votre panier est vide"
                const remainingItems = document.querySelectorAll('[id^="cart-item-"]').length;
                if (remainingItems === 0) {
                    window.location.reload();
                }

                showFlash(data.message, data.type);

            })
            .catch(() => {
                showFlash("Impossible de retirer le produit pour le moment.", 'danger');
            });
        }
    </script>
{% endblock %}