{% extends 'base.html.twig' %}

{% block title %}Éditer {{ user.pseudo }} | Back to the VHS{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round min-h-screen pt-20 md:pt-32 px-6"
     style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">

    <div class="max-w-lg mx-auto bg-gray-800/70 rounded-lg shadow-lg p-8 text-white">
        <h1 class="text-2xl font-bold text-yellow-400 mb-6">Modifier {{ user.pseudo }}</h1>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            <div>
                {{ form_label(form.pseudo, null, {'label_attr': {'class': 'block mb-1'}}) }}
                {{ form_widget(form.pseudo, {'attr': {'class': 'w-full rounded-md p-2 text-black'}}) }}
            </div>

            <div>
                {{ form_label(form.email, null, {'label_attr': {'class': 'block mb-1'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'w-full rounded-md p-2 text-black'}}) }}
            </div>

            <div>
                {{ form_label(form.roles, null, {'label_attr': {'class': 'block mb-1'}}) }}
                {{ form_widget(form.roles, {'attr': {'class': 'space-x-4'}}) }}
            </div>

            <button type="submit" 
                    class="bg-yellow-400 hover:bg-yellow-500 text-black px-6 py-2 rounded-md font-semibold">
                💾 Enregistrer
            </button>
            <a href="{{ path('app_admin_user_show', {id: user.id}) }}"
               class="ml-4 text-gray-300 hover:underline">⬅ Annuler</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}