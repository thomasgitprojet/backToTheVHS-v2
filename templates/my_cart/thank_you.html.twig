{% extends 'base.html.twig' %}

{% block title %}Merci pour votre commande !{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round flex flex-col items-center justify-center min-h-screen text-center"
     style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;);">

    <div class="bg-white/90 backdrop-blur-sm rounded-xl shadow-lg p-10 max-w-2xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-800 mb-6">Merci pour votre visite 🎬</h1>
        <p class="text-lg text-gray-700 mb-4">
            Vous venez d’arriver au bout du parcours utilisateur du site 
            <span class="font-semibold text-yellow-600">BackToTheVHS</span>.
        </p>
        <p class="text-gray-600 mb-6">
            Ce site est un projet fictif conçu pour présenter mes compétences en développement web.<br>
            Si vous avez remarqué un bug, souhaitez me faire un retour ou simplement poser une question, 
            n’hésitez pas à me contacter.
        </p>

        <a href="{{ path('app_contact') }}"
           class="inline-block bg-yellow-400 hover:bg-yellow-500 text-black font-semibold py-3 px-6 rounded-lg transition duration-200">
            👉 Me contacter
        </a>

        <p class="text-sm text-gray-500 mt-8">
            Merci encore d’avoir pris le temps d’explorer BackToTheVHS ❤️
        </p>
    </div>
</div>
{% endblock %}