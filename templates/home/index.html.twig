{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accueil | Back to the VHS{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round md:flex flex-col items-center md:pt-12 md:gap-6"
    style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">
    <div class="text-center">
        <h2 class="text-4xl font-bold mb-4">Bienvenue sur Back to the VHS</h2>
        <p class="text-lg">Un site de vente fictif de cassettes VHS vintage pour les vrais amateurs !</p>
    </div>
    <div class="max-w-7xl mx-auto p-6">
        <h2 class="text-3xl font-bold text-yellow-400 text-center mb-10">Nos derniers produits ajoutés</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
            {% for i in 1..8 %}
            <!-- Produit -->
            <div class="bg-gray-800/50 p-4 rounded-lg shadow-lg flex flex-col">
                <img src="{{ asset('build/images/bToVHS.png') }}" alt="Produit 1"
                    class="rounded-md mb-4 h-48 object-contain">
                <h3 class="text-xl font-semibold text-white mb-2">Nom du produit</h3>
                <p class="text-sm text-gray-300 mb-4">Petite description du produit très stylé.</p>
                <p class="text-yellow-400 font-bold text-lg mb-4">9,99 €</p>
                <a href="{{ path('app_product') }}"
                    class="mt-auto bg-yellow-400 text-black text-center py-2 px-4 rounded-md hover:bg-yellow-500 transition">
                    Voir le produit
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}