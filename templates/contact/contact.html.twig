{# templates/contact/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Hello ContactController!{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Contact - BackToTheVHS{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round md:flex flex-col items-center md:pt-12 md:gap-6"
     style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">

    <div class="max-w-3xl mx-auto bg-white p-8 rounded-lg shadow-lg">
        <h1 class="text-4xl font-bold mb-6 text-gray-800">Contactez-nous</h1>

        {% for message in app.flashes('success') %}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <p class="mb-4 text-gray-600">
            Vous avez une question, une suggestion, ou besoin d’aide ?
            Remplissez le formulaire ci-dessous, nous vous répondrons rapidement !
        </p>

        {{ form_start(contactForm) }}
            <div class="space-y-6">
                {{ form_row(contactForm.name, {'attr': {'class': 'w-full border border-gray-300 rounded-md p-3'}}) }}
                {{ form_row(contactForm.email, {'attr': {'class': 'w-full border border-gray-300 rounded-md p-3'}}) }}
                {{ form_row(contactForm.subject, {'attr': {'class': 'w-full border border-gray-300 rounded-md p-3'}}) }}
                {{ form_row(contactForm.message, {'attr': {'class': 'w-full border border-gray-300 rounded-md p-3 resize-none'}}) }}
            </div>

            {# ✅ reCAPTCHA v2 #}
            <div class="g-recaptcha mt-6" data-sitekey="{{ recaptcha_site_key }}"></div>

            <button type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-md mt-6">
                Envoyer
            </button>
        {{ form_end(contactForm) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endblock %}