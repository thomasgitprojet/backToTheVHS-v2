<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>{% block title %}Back To The VHS{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>

<body class="bg-gray-900 text-white font-sans min-h-screen flex flex-col">

    {# Flash messages Symfony #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div
                class="flash-message fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 
                        px-6 py-4 rounded-lg shadow-lg z-50 text-center text-lg transition-opacity 
                        duration-1000 ease-in-out
                        {% if label == 'success' %} bg-green-600 text-white
                        {% elseif label == 'danger' %} bg-red-600 text-white
                        {% elseif label == 'warning' %} bg-yellow-500 text-black
                        {% else %} bg-gray-700 text-white
                        {% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Header -->
    <header class="bg-black text-yellow-400 py-6 px-4 text-center shadow-lg">
        <div class="text-center md:flex flex-col md:items-start md:pt-12">
            <img src="{{ asset('build/images/bToVHS.png') }}" alt="Back To The VHS"
                class="w-64 mx-auto md:w-96 md:mx-0">
            <p class="text-sm text-yellow-400 mt-2 mb-4 md:text-lg md:pl-12">La vintage n’a jamais été aussi stylé</p>
        </div>
        <div>
            <ul class="flex justify-center gap-4 md:justify-end">
                <li class="flex items-end">
                    {% if app.user %}
                    <form action="{{ path('app_logout') }}" method="POST">
                        <button type="submit" class="hover:text-yellow-400 transition">Déconnexion</button>
                    </form>
                    {% else %}
                    <a href="{{ path('app_connection') }}" class="hover:text-yellow-400 transition">Connexion</a>
                    {% endif %}
                </li>
                <li>
                    <a class="flex items-end gap-2" href="{{ path('app_account') }}">
                        <img src="{{ asset('build/images/icons8-account-30.png') }}" alt="icon compte">
                        mon compte
                    </a>
                </li>
                <li class="relative">
                    <a class="flex items-end gap-2" href="{{ path('app_my_cart') }}">
                    <img src="{{ asset('build/images/icons8-basket-30.png') }}" alt="">
                    mon panier
                    {% set cartCount = app.session.get('cart') ? app.session.get('cart')|length : 0 %}
                    {% if cartCount > 0 %}
                        <span id="cart-count"
                            class="absolute -top-2 -right-3 bg-yellow-400 text-black rounded-full w-5 h-5 text-xs flex items-center justify-center">
                            {{ cartCount }}
                        </span>
                    {% endif %}
                </a>
                </li>
            </ul>
        </div>
    </header>

    <!-- Navigation mobile -->
    <nav class="bg-gray-800 text-white py-3 shadow-md md:hidden">
        <button id="burger-btn" class="flex justify-center ml-6 md:hidden text-white text-3xl"
            aria-label="Ouvrir le menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
        <button id="close-btn" class="flex justify-center ml-6 hidden md:hidden text-white text-3xl"
            aria-label="Fermer le menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24"
                stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
        </button>
        <ul id="mobile-menu" class="hidden bg-gray-800 w-full text-lg font-medium flex flex-col gap-6 pl-12 absolute">
            <li><a href="{{ path('home') }}" class="hover:text-yellow-400 transition">Accueil</a></li>
            <li><a href="{{ path('app_products') }}" class="hover:text-yellow-400 transition">Catalogue</a></li>
            <li><a href="{{ path('app_contact') }}" class="hover:text-yellow-400 transition">Contact</a></li>
        </ul>
    </nav>

    <!-- Navigation desktop -->
    <nav class="bg-gray-800 text-white py-3 px-6 shadow-md hidden md:block">
        <ul class="flex justify-center gap-6 text-lg font-medium md:text-2xl">
            <li><a href="{{ path('home') }}" class="hover:text-yellow-400 transition">Accueil</a></li>
            <li><a href="{{ path('app_products') }}" class="hover:text-yellow-400 transition">Catalogue</a></li>
            <li><a href="{{ path('app_contact') }}" class="hover:text-yellow-400 transition">Contact</a></li>
        </ul>
    </nav>

    <!-- Contenu principal -->
    <main>
        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-black text-center text-sm text-gray-500 py-4">
        &copy; {{ "now"|date("Y") }} Back To The VHS - Tous droits réservés
    </footer>

    {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {# Script Flash Messages #}
    <script>
        setTimeout(() => {
            document.querySelectorAll('.flash-message').forEach(flash => {
                flash.classList.add('opacity-0');
                setTimeout(() => flash.remove(), 1000);
            });
        }, 3000);
    </script>

    {# Script ajout au panier et compteur dynamique #}
    <script>
        function addToCart(productId) {
            fetch(`/cart/add/${productId}`)
                .then(response => response.json())
                .then(data => {
                    // Met à jour le compteur
                    let counter = document.getElementById('cart-count');
                    if (!counter) {
                        counter = document.createElement('span');
                        counter.id = 'cart-count';
                        counter.className = 'absolute -top-2 -right-3 bg-yellow-400 text-black rounded-full w-5 h-5 text-xs flex items-center justify-center';
                        document.querySelector('a[href$="/my/cart"]').appendChild(counter);
                    }
                    counter.textContent = data.count;

                    // Crée et affiche le flash message
                    const flash = document.createElement('div');
                    flash.className = `flash-message fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 px-6 py-4 rounded-lg shadow-lg z-50 text-center text-lg transition-opacity duration-1000 ease-in-out ${
                        data.type === 'danger' ? 'bg-red-600 text-white' :
                        data.type === 'warning' ? 'bg-yellow-500 text-black' :
                        'bg-green-600 text-white'
                    }`;
                    flash.textContent = data.message;
                    document.body.appendChild(flash);

                    setTimeout(() => {
                        flash.classList.add('opacity-0');
                        setTimeout(() => flash.remove(), 1000);
                    }, 3000);
                })
                .catch(() => alert("Impossible d'ajouter le produit pour le moment."));
        }
    </script>
</body>
</html>