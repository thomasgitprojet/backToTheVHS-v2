# Modèle du fichier .env (variables d'environnement).
# Pour installer le projet : copier ce fichier en .env, puis remplacer les valeurs de démonstration.
# Ne jamais versionner le vrai .env : il contient des mots de passe.

###> Base de données MySQL (Docker) ###
# L'application se connecte en root : MYSQL_PASSWORD doit être identique à MYSQL_ROOT_PASSWORD.
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=app
MYSQL_VERSION=8.4.4
MYSQL_CHARSET=utf8mb4
###< Base de données MySQL ###

###> Symfony ###
APP_ENV=dev
APP_SECRET=change_me_with_a_random_string
###< Symfony ###

###> Serveur web FrankenPHP / Caddy (Docker) ###
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
CADDY_MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
CADDY_MERCURE_URL=http://php/.well-known/mercure
CADDY_MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
###< Serveur web ###

###> E-mails ###
# En développement : smtp://mailer:1025 (Mailpit). En production : le SMTP de l'hébergeur.
MAILER_DSN=null://null
###< E-mails ###

###> reCAPTCHA (Google) ###
# Clés de TEST publiées par Google : la case est toujours validée, sans vraie vérification.
# À remplacer par vos propres clés (console Google reCAPTCHA) pour un vrai site.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
###< reCAPTCHA ###