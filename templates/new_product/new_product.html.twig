{# templates/new_product/new_product.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Hello NewProductController!{% endblock %}

{% block content %}
    <div class="bg-contain bg-repeat-round md:flex flex-col items-center md:pt-12 md:gap-6"
        style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">
        <div class="max-w-2xl mx-auto mt-12 bg-gray-800/50 p-8 rounded-lg shadow-lg text-white">
            <h2 class="text-2xl font-bold mb-6 text-center">📝 Créer une nouvelle annonce</h2>

            <form action="#" method="post" enctype="multipart/form-data" class="space-y-6">
                <!-- Nom du produit -->
                <div>
                <label for="nom" class="block text-sm font-medium mb-1">Nom du produit</label>
                <input type="text" id="nom" name="nom" class="w-full px-4 py-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                </div>

                <!-- Description -->
                <div>
                <label for="description" class="block text-sm font-medium mb-1">Description</label>
                <textarea id="description" name="description" rows="4" class="w-full px-4 py-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-400"></textarea>
                </div>

                <!-- Prix -->
                <div>
                <label for="prix" class="block text-sm font-medium mb-1">Prix (en €)</label>
                <input type="number" id="prix" name="prix" step="0.01" class="w-full px-4 py-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                </div>

                <!-- Image -->
                <div>
                <label for="image" class="block text-sm font-medium mb-1">Image du produit</label>
                <input type="file" id="image" name="image" accept="image/*" class="w-full text-sm text-gray-300 file:bg-yellow-400 file:text-black file:font-semibold file:py-2 file:px-4 file:rounded-md file:border-0 hover:file:bg-yellow-500">
                </div>

                <!-- Bouton de soumission -->
                <div class="text-center pt-4">
                <button type="submit" class="bg-yellow-400 hover:bg-yellow-500 text-black font-semibold px-6 py-2 rounded-md text-sm">
                    ✅ Publier l’annonce
                </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
