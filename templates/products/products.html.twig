{# templates/products/products.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Catalogue | Back to the VHS{% endblock %}

{% block content %}
<div class="bg-contain bg-repeat-round md:flex flex-col items-center md:pt-12 md:gap-6"
    style="background-image: url(&quot;{{ asset('build/images/background.png') }}&quot;)">
    <div class="max-w-7xl mx-auto p-6">
        <h2 class="text-3xl font-bold text-yellow-400 text-center mb-10">Catalogue</h2>

        <!-- Filtres -->
        <form method="get" class="mb-8 bg-gray-800/50 p-4 rounded-lg shadow-md grid grid-cols-1 sm:grid-cols-3 gap-4">
            <input type="text" name="search" value="{{ search }}" placeholder="Rechercher par titre..."
                class="w-full px-4 py-2 rounded-md bg-gray-700 text-white placeholder-gray-400 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-400">

            <select name="filter_sort" class="w-full px-4 py-2 rounded-md bg-gray-700 text-white border border-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-400"
                    onchange="this.form.submit()">
                <option value="default" {% if sort == 'default' %}selected{% endif %}>Trier par</option>
                <option value="price_asc"  {% if sort == 'price_asc' %}selected{% endif %}>Prix croissant</option>
                <option value="price_desc" {% if sort == 'price_desc' %}selected{% endif %}>Prix décroissant</option>
                <option value="title_asc"  {% if sort == 'title_asc' %}selected{% endif %}>Titre A-Z</option>
                <option value="title_desc" {% if sort == 'title_desc' %}selected{% endif %}>Titre Z-A</option>
            </select>

            <button type="submit" class="bg-yellow-400 text-black rounded-md px-4 py-2 hover:bg-yellow-500 transition">
                Filtrer
            </button>
        </form>


        <!-- Grille des produits -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
            {% for publication in publications %}
                <div class="bg-gray-800/50 p-4 rounded-lg shadow-lg flex flex-col">
                    <img src="{{ asset('uploads/images/' ~ publication.product.image) }}" 
                        alt="{{ publication.product.movie.title }}" 
                        class="rounded-md mb-4 h-48 object-contain">

                    <h3 class="text-xl font-semibold text-white mb-2">{{ publication.product.movie.title }}</h3>
                    <p class="text-sm text-gray-300 mb-4">{{ publication.product.descriptionProduct }}</p>
                    <p class="text-yellow-400 font-bold text-lg mb-4">{{ publication.product.priceProduct }} €</p>

                    <a href="{{ path('app_product', { id: publication.id }) }}" 
                    class="mt-auto bg-yellow-400 text-black text-center py-2 px-4 rounded-md hover:bg-yellow-500 transition">
                        Voir le produit
                    </a>
                </div>
            {% else %}
                <p class="text-gray-300 col-span-full text-center">Aucun produit trouvé.</p>
            {% endfor %}
        </div>

        <!-- Pagination -->
        <div class="mt-10 flex justify-center items-center gap-4">
            {{ knp_pagination_render(publications) }}
        </div>
    </div>
</div>
{% endblock %}